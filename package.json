{
  "name": "enactiva-plataforma",
  "private": true,
  "description": "Plataforma de capacitación entre pares — piloto ENACTIVA SpA (Capstone PTY4614)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter api --filter web --parallel --if-present dev",
    "dev:servicios": "pnpm --filter api-gateway --filter auth-service --filter identity-service --filter learning-service --filter matching-service --parallel dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:paquetes": "pnpm --filter @enactiva/shared build && pnpm --filter @enactiva/service-kit build",
    "typecheck": "pnpm build:paquetes && pnpm -r --if-present typecheck",
    "test": "pnpm build:paquetes && pnpm -r --if-present test",
    "prepare": "pnpm build:paquetes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
