# Copiar a .env en la raíz del repositorio y completar. Nunca subir .env.
#
# Este archivo lo leen los microservicios y el gateway (ADR-0007). El monolito apps/api sigue
# usando su propio apps/api/.env mientras exista; se elimina al terminar la fase M2.
#
# Un solo archivo para todos los servicios a propósito: el secreto del JWT tiene que ser el mismo
# en los cinco procesos, y mantener seis copias de la misma variable es la mejor forma de que se
# desincronicen sin que nadie se dé cuenta.

# ── Puertos ──────────────────────────────────────────────────────────────────
# El monolito se queda con el 3000 durante M0 y M1: es el que la web sigue usando.
# El gateway toma el 3000 en M2, cuando apps/api se retire.
PORT_GATEWAY=3010
PORT_AUTH=3101
PORT_IDENTITY=3102
PORT_LEARNING=3103
PORT_MATCHING=3104

# ── Bases de datos ───────────────────────────────────────────────────────────
# Coinciden con docker/postgres/00-bases.sql. auth-service no tiene base propia.
DATABASE_URL_IDENTITY=postgresql://svc_identity:identity@localhost:5432/identity_db
DATABASE_URL_LEARNING=postgresql://svc_learning:learning@localhost:5432/learning_db
DATABASE_URL_MATCHING=postgresql://svc_matching:matching@localhost:5432/matching_db

# ── Autenticación ────────────────────────────────────────────────────────────
# Mínimo 32 caracteres cada uno. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# JWT_ACCESS_SECRET lo comparten los cinco servicios: auth-service firma, los demás verifican.
JWT_ACCESS_SECRET=
# Solo lo usa identity-service: es donde se calcula el hash de los tokens de refresh.
REFRESH_TOKEN_PEPPER=
# Secreto de las rutas /interno/*, que auth-service usa para hablar con identity-service.
# Esas rutas son anteriores al login, así que no hay token de usuario que reenviar.
INTERNO_SECRETO=
# Intentos de login permitidos por minuto y por IP (opcional, por defecto 5)
# LOGIN_INTENTOS_POR_MINUTO=5

# ── URLs internas ────────────────────────────────────────────────────────────
# El gateway enruta hacia aquí; auth-service llama a identity para verificar credenciales.
URL_AUTH_SERVICE=http://localhost:3101
URL_IDENTITY_SERVICE=http://localhost:3102
URL_LEARNING_SERVICE=http://localhost:3103
URL_MATCHING_SERVICE=http://localhost:3104

# ── Frontend ─────────────────────────────────────────────────────────────────
# Origen autorizado a llamar al gateway con cookies (opcional, por defecto http://localhost:5173)
# WEB_ORIGIN=http://localhost:5173

# ── Admin Principal inicial (seed de identity-service) ───────────────────────
# Contraseña de al menos 12 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_APELLIDO=

# ── Correo (identity-service) ────────────────────────────────────────────────
# En local apunta a Mailpit, que no envía nada a internet (ADR-0004).
SMTP_HOST=localhost
SMTP_PORT=1025
# Remitente de los correos (opcional en local)
# CORREO_DESDE=ENACTIVA <no-responder@plataforma.local>
