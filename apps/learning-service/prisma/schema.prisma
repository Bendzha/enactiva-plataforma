// Modelo de datos de learning-service — ADR-0002 (dominio), ADR-0007 (reparto entre servicios),
// ADR-0008 (ficha de taller) y ADR-0010 (se elimina el modelo de evaluación).
//
// Aquí vive lo que pasa alrededor de un taller: la convocatoria, quién se inscribe y cuándo
// puede enseñar cada facilitador. No hay etapas, rúbricas ni mediciones: la clienta las sacó
// del alcance el 2026-10-13.
//
// `capacitadorId`, `usuarioId` y `temaId` se guardan sin clave foránea: esos datos viven en
// identity_db y Postgres no puede validarlos entre bases distintas (ADR-0007). La validación
// la hace el servicio preguntándole a identity con el token de quien pide.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

/// Copia del enum de identity_db. No es duplicación por descuido: cada base es independiente y
/// el registro de auditoría de este servicio necesita saber con qué rol actuó alguien.
enum Rol {
  ADMIN_ENACTIVA
  RRHH
  CAPACITADOR
  ESTUDIANTE
}

enum AccionAuditoria {
  LOGIN
  LOGIN_FALLIDO
  LEER
  CREAR
  ACTUALIZAR
  ELIMINAR
  EXPORTAR
  ANONIMIZAR
}

/// Las cuatro dimensiones del ejemplo que mandó la clienta (WhatsApp 2026-09-29, Q16).
/// Van como filas de `estrella_valoracion` y no como columnas: ella dijo que se pueden agregar
/// o cambiar más adelante, y eso no puede costar una migración.
enum DimensionValoracion {
  CLARIDAD
  SEGURIDAD
  APLICACION
  USO_DE_MATERIALES
}

/// Cuándo se mandó un recordatorio. Son dos: uno el día antes, para reorganizar la agenda,
/// y otro una hora antes, que es el que de verdad hace que la gente llegue.
enum MomentoRecordatorio {
  VEINTICUATRO_HORAS
  UNA_HORA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

// ── Talleres ─────────────────────────────────────────────────────────────────

/// La ficha de un taller presencial (acta 2026-09-29): lo que alguien necesita para decidir si va.
///
/// No hay archivos ni contenidos: la plataforma no aloja clases (ADR-0008). Tampoco hay etapas
/// ni estados de avance: el taller ocurre una vez (ADR-0010). Lo único que decide si todavía se
/// puede entrar son la fecha y el cupo.
model Taller {
  id                  String    @id @default(uuid(7)) @db.Uuid
  empresaId           String    @map("empresa_id") @db.Uuid
  /// Quien lo dicta. Vive en identity_db.
  capacitadorId       String    @map("capacitador_id") @db.Uuid
  /// Tema del catálogo de la empresa. Vive en identity_db.
  temaId              String    @map("tema_id") @db.Uuid
  nombre              String
  objetivo            String
  resultadosEsperados String    @map("resultados_esperados")
  ubicacion           String
  inicioAt            DateTime  @map("inicio_at") @db.Timestamptz(3)
  finAt               DateTime  @map("fin_at") @db.Timestamptz(3)
  cupo                Int
  /// Cuándo quien dicta cerró la lista de asistencia. Los tokens se entregan ahí y una sola
  /// vez; después la lista no se reabre, porque lo que salió de ella ya está repartido.
  asistenciaCerradaAt DateTime? @map("asistencia_cerrada_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  inscripciones Inscripcion[]
  recordatorios RecordatorioTaller[]
  valoraciones  ValoracionTaller[]

  @@index([empresaId, inicioAt])
  @@index([empresaId, capacitadorId])
  @@index([empresaId, temaId])
  @@map("taller")
}

/// Alguien va a ir. El par (taller, persona) es único: inscribirse dos veces no significa nada,
/// y el cupo dejaría de cuadrar.
model Inscripcion {
  id        String   @id @default(uuid(7)) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  tallerId  String   @map("taller_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  /// La marca quien dicta al pasar lista. Null mientras no la haya pasado: "todavía no se
  /// sabe" y "no fue" son cosas distintas, y de la diferencia dependen los tokens.
  asistio   Boolean?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([tallerId, usuarioId])
  @@index([empresaId, usuarioId])
  @@map("inscripcion")
}

/// Constancia de que un recordatorio ya salió, para no mandarlo dos veces.
///
/// Se anota por taller y no por persona: los correos salen todos juntos cuando el taller entra
/// en ventana. Quien se inscribe después de que salió el de 24 horas no lo recibe —a esa altura
/// ya no tendría sentido— pero sí el de una hora antes, que todavía no ha salido.
model RecordatorioTaller {
  id        String              @id @default(uuid(7)) @db.Uuid
  empresaId String              @map("empresa_id") @db.Uuid
  tallerId  String              @map("taller_id") @db.Uuid
  momento   MomentoRecordatorio
  /// Cuántos correos salieron. Si fueron cero, igual se anota: el taller no tenía a nadie.
  enviados  Int
  enviadoAt DateTime            @default(now()) @map("enviado_at") @db.Timestamptz(3)

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([tallerId, momento])
  @@index([empresaId])
  @@map("recordatorio_taller")
}

/// Cuándo puede enseñar una persona, semana a semana (acta 2026-09-29).
///
/// Las horas se guardan como texto "HH:MM" en 24 horas: así se leen directo en la base y, al
/// llevar cero a la izquierda, ordenarlas alfabéticamente las ordena por hora.
model Disponibilidad {
  id         String    @id @default(uuid(7)) @db.Uuid
  empresaId  String    @map("empresa_id") @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  dia        DiaSemana
  horaInicio String    @map("hora_inicio")
  horaFin    String    @map("hora_fin")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([usuarioId, dia, horaInicio, horaFin])
  @@index([empresaId, usuarioId])
  @@map("disponibilidad")
}

// ── Valoración del encuentro y reconocimiento (SPEC §3.5, ADR-0009) ──────────

/// Lo que una persona respondió al cerrar un taller.
///
/// Una por persona y por taller: valorar dos veces el mismo encuentro inflaría el promedio de
/// quien lo dictó, que es un número con consecuencias (ordena el mazo y da tokens).
model ValoracionTaller {
  id        String   @id @default(uuid(7)) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  tallerId  String   @map("taller_id") @db.Uuid
  /// Quien valora. Vive en identity_db.
  usuarioId String   @map("usuario_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  taller     Taller               @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  estrellas  EstrellaValoracion[]
  referencia Referencia?

  @@unique([tallerId, usuarioId])
  @@index([empresaId, tallerId])
  @@index([empresaId, usuarioId])
  @@map("valoracion_taller")
}

/// Una estrella por dimensión, de 1 a 5 (escala confirmada el 2026-10-24).
model EstrellaValoracion {
  valoracionId String              @map("valoracion_id") @db.Uuid
  dimension    DimensionValoracion
  estrellas    Int

  valoracion ValoracionTaller @relation(fields: [valoracionId], references: [id], onDelete: Cascade)

  @@id([valoracionId, dimension])
  @@map("estrella_valoracion")
}

/// Texto libre de una persona sobre otra, dentro de su trabajo. Lo más delicado que guarda la
/// plataforma (ADR-0009), así que va firmado y RRHH puede ocultarlo.
///
/// Ocultar **no borra**: borrar la evidencia de un conflicto laboral es peor que conservarla.
model Referencia {
  id            String    @id @default(uuid(7)) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  valoracionId  String    @unique @map("valoracion_id") @db.Uuid
  tallerId      String    @map("taller_id") @db.Uuid
  /// Quien la escribe. Se publica con su nombre y lo sabe antes de escribirla.
  autorId       String    @map("autor_id") @db.Uuid
  /// Sobre quién es: el facilitador del taller, copiado para no rehacer el join en cada lectura.
  capacitadorId String    @map("capacitador_id") @db.Uuid
  texto         String
  ocultaAt      DateTime? @map("oculta_at") @db.Timestamptz(3)
  ocultaPorId   String?   @map("oculta_por_id") @db.Uuid
  motivoOculta  String?   @map("motivo_oculta")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  valoracion ValoracionTaller @relation(fields: [valoracionId], references: [id], onDelete: Cascade)

  @@index([empresaId, capacitadorId])
  @@index([empresaId, tallerId])
  @@map("referencia")
}

/// Por qué alguien recibió tokens. Las tres razones que fijó la clienta el 2026-10-29.
enum MotivoToken {
  DICTAR_TALLER
  ASISTENCIA_COMPLETA
  ASISTIR
}

/// El recuento de tokens (Q18, reglas del 2026-10-29).
///
/// La plataforma lleva la cuenta y nada más: el canje lo administra cada empresa fuera de aquí.
/// Como afuera valen algo, nadie lo edita a mano: las filas nacen **solo** al cerrar la lista de
/// asistencia de un taller, y la clave única sobre (taller, persona, motivo) impide repartir dos
/// veces lo mismo aunque la petición se repita.
///
/// Una fila por motivo y no un saldo acumulado: así el recuento siempre se puede explicar
/// —de qué taller salió cada token y por qué— y se corrige borrando una fila, no editando un
/// número.
model Token {
  id        String      @id @default(uuid(7)) @db.Uuid
  empresaId String      @map("empresa_id") @db.Uuid
  /// Quien lo recibe: quien dictó, o quien asistió. Vive en identity_db.
  usuarioId String      @map("usuario_id") @db.Uuid
  tallerId  String      @map("taller_id") @db.Uuid
  motivo    MotivoToken
  cantidad  Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tallerId, usuarioId, motivo])
  @@index([empresaId, usuarioId])
  @@map("token")
}

// ── Cumplimiento Ley 21.719 ──────────────────────────────────────────────────

/// Append-only: un trigger en la base rechaza UPDATE y DELETE.
/// Cada servicio tiene su propia copia de esta tabla en su base (ADR-0007); la exportación y la
/// supresión de los datos de una persona se orquestan desde el gateway.
/// Nunca guarda valores de datos personales, solo nombres de campos.
model RegistroAuditoria {
  id                BigInt          @id @default(autoincrement())
  actorId           String?         @map("actor_id") @db.Uuid
  actorRol          Rol?            @map("actor_rol")
  empresaId         String?         @map("empresa_id") @db.Uuid
  accion            AccionAuditoria
  entidad           String
  entidadId         String?         @map("entidad_id")
  camposModificados String[]        @map("campos_modificados")
  ip                String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([empresaId, createdAt])
  @@index([actorId, createdAt])
  @@map("registro_auditoria")
}
