# Copiar a apps/api/.env y completar. Nunca subir .env al repositorio.
# Las variables se van activando slice a slice (ver tasks/plan.md).

# API (T0.3)
PORT=3000

# Base de datos local: coincide con docker-compose.yml (T0.2)
DATABASE_URL=postgresql://enactiva:enactiva@localhost:5432/plataforma

# Admin Principal inicial para el seed (T0.4). Contraseña de al menos 12 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_APELLIDO=

# Autenticación (T0.6) — generar valores largos y aleatorios
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=

# Correo local con Mailpit (Slice 1)
SMTP_HOST=localhost
SMTP_PORT=1025
