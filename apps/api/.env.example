# Copiar a apps/api/.env y completar. Nunca subir .env al repositorio.
# Las variables se van activando slice a slice (ver tasks/plan.md).

# API (T0.3)
PORT=3000

# Base de datos local: coincide con docker-compose.yml (T0.2)
DATABASE_URL=postgresql://enactiva:enactiva@localhost:5432/plataforma

# Admin Principal inicial para el seed (T0.4). Contraseña de al menos 12 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_APELLIDO=

# Autenticación (T0.6). Mínimo 32 caracteres cada uno; generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
# Intentos de login permitidos por minuto y por IP (opcional, por defecto 5)
LOGIN_INTENTOS_POR_MINUTO=
# Origen del frontend autorizado (opcional, por defecto http://localhost:5173)
WEB_ORIGIN=

# Correo local con Mailpit (Slice 1)
SMTP_HOST=localhost
SMTP_PORT=1025
# Remitente de los correos (opcional en local)
CORREO_DESDE=
