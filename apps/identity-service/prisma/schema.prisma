// Modelo de datos de identity-service — ADR-0002 (dominio) y ADR-0007 (reparto entre servicios).
//
// Estas tablas vienen del monolito sin cambios de estructura: es una mudanza, no un rediseño.
// El historial de migraciones sí parte de cero, porque la base es nueva.
//
// identity_db es la dueña de `Usuario`, `UsuarioRol` y `TokenAcceso` (ADR-0007, decisión D1):
// auth-service no tiene base propia y le pide a este servicio que verifique las credenciales.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN_ENACTIVA
  RRHH
  CAPACITADOR
  ESTUDIANTE
}

enum NivelAdmin {
  PRINCIPAL
  OPERATIVO
}

enum EstadoEmpresa {
  ONBOARDING_PENDIENTE
  ACTIVA
}

enum EstadoUsuario {
  INVITADO
  ACTIVO
  SUSPENDIDO
  ANONIMIZADO
}

/// Las tres dimensiones de lo que alguien puede enseñar o quiere aprender (SPEC §3.6). En la
/// reunión del 2026-09-29 la clienta las nombró como habilidades, conocimientos y actitudes.
enum Dimension {
  HABILIDAD
  CONTENIDO
  ACTITUD
}

enum TipoInteres {
  ENSENAR
  APRENDER
}

/// Escala de tres pasos, confirmada por la clienta el 2026-10-13.
enum NivelDominio {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum TipoToken {
  REFRESH
  INVITACION
  RESET_PASSWORD
}

enum AccionAuditoria {
  LOGIN
  LOGIN_FALLIDO
  LEER
  CREAR
  ACTUALIZAR
  ELIMINAR
  EXPORTAR
  ANONIMIZAR
}

// ── Organización e identidad ─────────────────────────────────────────────────

model Empresa {
  id            String        @id @default(uuid(7)) @db.Uuid
  nombre        String
  rubro         String
  estado        EstadoEmpresa @default(ONBOARDING_PENDIENTE)
  activadaAt    DateTime?     @map("activada_at") @db.Timestamptz(3)
  activadaPorId String?       @map("activada_por_id") @db.Uuid
  creadaPorId   String        @map("creada_por_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  activadaPor Usuario?  @relation("EmpresaActivadaPor", fields: [activadaPorId], references: [id], onDelete: Restrict)
  creadaPor   Usuario   @relation("EmpresaCreadaPor", fields: [creadaPorId], references: [id], onDelete: Restrict)
  usuarios    Usuario[] @relation("UsuariosDeEmpresa")
  areas       Area[]
  temas       Tema[]

  @@map("empresa")
}

/// Área o departamento dentro de una empresa (Operaciones, Finanzas…).
/// El nombre normalizado evita duplicados por mayúsculas o tildes.
model Area {
  id                String   @id @default(uuid(7)) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  nombre            String
  nombreNormalizado String   @map("nombre_normalizado")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarios Usuario[]

  @@unique([empresaId, nombreNormalizado])
  @@map("area")
}

/// Invariantes de aplicación (ADR-0002):
/// - nivelAdmin no nulo ⇔ el usuario tiene el rol ADMIN_ENACTIVA.
/// - empresaId nulo ⇔ usuario del equipo ENACTIVA.
/// - email se guarda en minúsculas; queda nulo al anonimizar.
model Usuario {
  id            String        @id @default(uuid(7)) @db.Uuid
  empresaId     String?       @map("empresa_id") @db.Uuid
  areaId        String?       @map("area_id") @db.Uuid
  email         String?       @unique
  passwordHash  String?       @map("password_hash")
  nombre        String?
  apellido      String?
  cargo         String?
  estado        EstadoUsuario @default(INVITADO)
  nivelAdmin    NivelAdmin?   @map("nivel_admin")
  anonimizadoAt DateTime?     @map("anonimizado_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa           Empresa?          @relation("UsuariosDeEmpresa", fields: [empresaId], references: [id], onDelete: Restrict)
  area              Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  roles             UsuarioRol[]
  tokens            TokenAcceso[]
  aceptaciones      AceptacionAviso[]
  perfil            PerfilCorporativo?
  intereses         PerfilInteres[]
  temasCreados      Tema[]            @relation("TemaCreadoPor")
  empresasCreadas   Empresa[]         @relation("EmpresaCreadaPor")
  empresasActivadas Empresa[]         @relation("EmpresaActivadaPor")

  @@index([empresaId])
  @@map("usuario")
}

model UsuarioRol {
  usuarioId String   @map("usuario_id") @db.Uuid
  rol       Rol
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rol])
  @@map("usuario_rol")
}

/// Tokens de refresh, invitación y reseteo. Solo se guarda el hash, nunca el token.
/// auth-service genera los de refresh, pero el hash se calcula y se guarda aquí: el
/// REFRESH_TOKEN_PEPPER no sale de este servicio (ADR-0007).
model TokenAcceso {
  id         String    @id @default(uuid(7)) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tipo       TipoToken
  tokenHash  String    @unique @map("token_hash")
  expiraAt   DateTime  @map("expira_at") @db.Timestamptz(3)
  usadoAt    DateTime? @map("usado_at") @db.Timestamptz(3)
  revocadoAt DateTime? @map("revocado_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@map("token_acceso")
}

// ── Qué enseña y qué quiere aprender cada quien ──────────────────────────────

/// Tema del catálogo de una empresa ("Excel avanzado", "Hablar en público").
///
/// El catálogo es por empresa y el nombre normalizado es único dentro de ella (SPEC §3.6):
/// si "Excel" y "excel " convivieran como temas distintos, el matching no encontraría a la
/// persona que sí puede enseñarlo. El buscador sugiere los existentes antes de crear uno nuevo.
///
/// El tema no lleva dimensión: la dimensión es de la declaración, porque alguien puede querer
/// aprender un tema como habilidad y otra persona ofrecerlo como contenido, y de esa diferencia
/// vive el criterio "dimensiones coincidentes" del score de afinidad.
model Tema {
  id                String   @id @default(uuid(7)) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  nombre            String
  nombreNormalizado String   @map("nombre_normalizado")
  creadoPorId       String?  @map("creado_por_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  creadoPor Usuario?        @relation("TemaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  intereses PerfilInteres[]

  @@unique([empresaId, nombreNormalizado])
  @@map("tema")
}

/// Una declaración: "puedo enseñar este tema" o "quiero aprender este tema".
///
/// La empresa está duplicada aquí a propósito, para que el acotado por empresa (ADR-0003) filtre
/// sin pasar por el usuario ni por el tema.
/// Una persona declara un tema una sola vez por tipo, pero puede enseñar y querer aprender el
/// mismo tema: enseñar Excel no impide querer aprenderlo mejor.
model PerfilInteres {
  id          String       @id @default(uuid(7)) @db.Uuid
  empresaId   String       @map("empresa_id") @db.Uuid
  usuarioId   String       @map("usuario_id") @db.Uuid
  temaId      String       @map("tema_id") @db.Uuid
  tipo        TipoInteres
  dimensiones Dimension[]
  nivel       NivelDominio
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tema    Tema    @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, temaId, tipo])
  @@index([empresaId, temaId, tipo])
  @@map("perfil_interes")
}

/// Perfil corporativo. Solo guarda los intereses generales en texto libre: el resto del perfil
/// son las declaraciones de arriba y los datos del puesto, que administra RRHH.
/// La clienta pidió recoger datos corporativos y limitar los personales (acta 2026-09-29).
model PerfilCorporativo {
  usuarioId          String   @id @map("usuario_id") @db.Uuid
  empresaId          String   @map("empresa_id") @db.Uuid
  interesesGenerales String   @default("") @map("intereses_generales")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("perfil_corporativo")
}

// ── Cumplimiento Ley 21.719 ──────────────────────────────────────────────────

/// Constancia de que la persona aceptó el aviso de privacidad al activar su cuenta
/// (Ley 21.719). Se guarda la versión del texto aceptado, no el texto.
model AceptacionAviso {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  versionAviso String   @map("version_aviso")
  aceptadoAt   DateTime @default(now()) @map("aceptado_at") @db.Timestamptz(3)
  ip           String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("aceptacion_aviso")
}

/// Append-only: un trigger en la base rechaza UPDATE y DELETE.
/// Sin FK a propósito: debe sobrevivir a la anonimización de usuarios.
/// Nunca guarda valores de datos personales, solo nombres de campos.
///
/// Cada servicio tiene su propia copia de esta tabla en su base (ADR-0007): la exportación y la
/// supresión de los datos de una persona se orquestan después de M2.
model RegistroAuditoria {
  id                BigInt          @id @default(autoincrement())
  actorId           String?         @map("actor_id") @db.Uuid
  actorRol          Rol?            @map("actor_rol")
  empresaId         String?         @map("empresa_id") @db.Uuid
  accion            AccionAuditoria
  entidad           String
  entidadId         String?         @map("entidad_id")
  camposModificados String[]        @map("campos_modificados")
  ip                String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([empresaId, createdAt])
  @@index([actorId, createdAt])
  @@map("registro_auditoria")
}
