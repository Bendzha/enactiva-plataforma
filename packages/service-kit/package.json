  "devDependencies": {
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
